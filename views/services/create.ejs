<%- include('../layout', { body: renderBody() }) %>
<% function renderBody() { %>
  <div class="container mx-auto px-4 py-8">
    <h2 class="text-3xl font-bold mb-6">Tạo Dịch Vụ Mới</h2>
    <div class="bg-white p-6 rounded-lg shadow-md">
      <form action="/service/create" method="POST">
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700">Tên Dịch Vụ</label>
          <input type="text" name="tenDichVu" class="mt-1 w-full px-4 py-2 border rounded-lg" required>
        </div>
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700">Mô Tả</label>
          <textarea name="moTa" class="mt-1 w-full px-4 py-2 border rounded-lg"></textarea>
        </div>
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700">Giá Mặc Định (VNĐ)</label>
          <input type="number" name="giaMacDinhAI" class="mt-1 w-full px-4 py-2 border rounded-lg" min="0">
        </div>
        <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700">Tạo Dịch Vụ</button>
      </form>
    </div>
  </div>
<% } %>