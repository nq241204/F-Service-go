<%- include('layout', { body: renderBody() }) %>

<% function renderBody() { %>
<div class="min-h-screen bg-gray-100 py-6 flex flex-col justify-center sm:py-12">
  <div class="relative py-3 sm:max-w-xl sm:mx-auto">
    <div class="relative px-4 py-10 bg-white mx-8 md:mx-0 shadow rounded-3xl sm:p-10">
      <div class="max-w-md mx-auto">
        <div class="divide-y divide-gray-200">
          <div class="py-8 text-base leading-6 space-y-4 text-gray-700 sm:text-lg sm:leading-7">
            <h1 class="text-3xl font-bold text-red-600 mb-4">
              <%= message %>
            </h1>
            <% if (error.status) { %>
              <p class="text-gray-600">Mã lỗi: <%= error.status %></p>
            <% } %>
            
            <% if (process.env.NODE_ENV === 'development' && error.stack) { %>
              <div class="mt-4">
                <h2 class="text-lg font-semibold text-gray-700">Chi tiết lỗi:</h2>
                <pre class="mt-2 p-4 bg-gray-100 rounded-lg overflow-x-auto">
                  <%= error.stack %>
                </pre>
              </div>
            <% } %>

            <div class="mt-6">
              <a href="/" class="text-blue-500 hover:text-blue-700">
                ← Quay lại trang chủ
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>