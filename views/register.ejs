<%- include('../layout', { body: renderBody() }) %>

<% function renderBody() { %>
    <div class="flex items-center justify-center min-h-screen -mt-20">
        <div class="w-full max-w-lg bg-white p-8 rounded-xl shadow-2xl border border-gray-100">
            <h2 class="text-3xl font-bold text-center text-gray-800 mb-6">Tạo Tài Khoản Mới</h2>
            <p class="text-center text-sm text-gray-500 mb-8">Tham gia F-Service để trải nghiệm dịch vụ tốt nhất.</p>

            <form action="/register" method="POST">
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="mb-5 md:col-span-2">
                        <label for="ten" class="block text-sm font-medium text-gray-700 mb-1">Tên Hiển Thị</label>
                        <input 
                            type="text" 
                            id="ten" 
                            name="ten" 
                            placeholder="VD: Nguyễn Văn A"
                            class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500"
                            required
                        >
                    </div>

                    <div class="mb-5 md:col-span-1">
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Địa chỉ Email</label>
                        <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            placeholder="VD: email@example.com"
                            class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500"
                            required
                        >
                    </div>
                    
                    <div class="mb-5 md:col-span-1">
                        <label for="role" class="block text-sm font-medium text-gray-700 mb-1">Bạn là?</label>
                        <select 
                            id="role" 
                            name="role"
                            class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500 bg-white"
                            required
                        >
                            <option value="user">Người dùng (Cần dịch vụ)</option>
                            <option value="member">Thành viên (Cung cấp dịch vụ)</option>
                        </select>
                    </div>

                    <div class="mb-6 md:col-span-2">
                        <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Mật khẩu</label>
                        <input 
                            type="password" 
                            id="password" 
                            name="password" 
                            placeholder="Tối thiểu 6 ký tự"
                            class="mt-1 block w-full px-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-indigo-500 focus:border-indigo-500"
                            minlength="6"
                            required
                        >
                    </div>
                </div>
                
                <button 
                    type="submit" 
                    class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-lg text-lg font-semibold text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500 transition duration-150 ease-in-out"
                >
                    Đăng Ký
                </button>
            </form>

            <div class="mt-6 text-center">
                <p class="text-sm text-gray-600">
                    Đã có tài khoản? 
                    <a href="/login" class="font-medium text-indigo-600 hover:text-indigo-500">Đăng nhập tại đây</a>
                </p>
            </div>
        </div>
    </div>
<% } %>