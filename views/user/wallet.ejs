<!-- views/user/wallet.ejs -->
<h2 class="fw-bold mb-4">Ví giao dịch - <%= user.ten || user.email %></h2>
<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card p-4 shadow-sm h-100">
            <h4 class="card-title text-center text-primary">Số dư hiện tại</h4>
            <h1 class="text-center fw-bold text-success my-3"><%= locals.balance ? balance.toLocaleString() : 'Đang tải...' %> VNĐ</h1>
            <p class="text-center text-muted">ID Ví: **<%= user.viGiaoDichId %>**</p>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card p-4 shadow-sm h-100">
            <h4 class="card-title">Nạp tiền (Deposit)</h4>
            <p class="text-muted">Số tiền nạp sẽ được xử lý qua cổng thanh toán giả định.</p>
            <form method="POST" action="/api/user/wallet/deposit" class="mt-3">
                <div class="mb-3">
                    <label for="depositAmount" class="form-label">Số tiền nạp (VNĐ)</label>
                    <input type="number" class="form-control" id="depositAmount" name="amount" required min="10000" step="1000" placeholder="Ví dụ: 100000" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Xác nhận Nạp tiền</button>
            </form>
            <!-- QR Code: Giả định controller trả về qrCode base64/url -->
            <% if (locals.qrCode) { %>
                <div class="text-center mt-4 border-top pt-3">
                    <p>Quét mã QR để thanh toán:</p>
                    <img src="<%= qrCode %>" alt="QR Code" class="img-fluid" style="max-width: 150px;" />
                </div>
            <% } %>
        </div>
    </div>
    
    <div class="col-md-6 mb-4">
        <div class="card p-4 shadow-sm h-100">
            <h4 class="card-title">Rút tiền (Withdraw)</h4>
            <p class="text-muted">Yêu cầu rút tiền cần được Admin xét duyệt.</p>
            <form method="POST" action="/api/user/wallet/withdraw" class="mt-3">
                <div class="mb-3">
                    <label for="withdrawAmount" class="form-label">Số tiền rút (VNĐ)</label>
                    <input type="number" class="form-control" id="withdrawAmount" name="amount" required min="50000" step="1000" placeholder="Ví dụ: 500000" />
                    <small class="text-danger">Tối thiểu: 50,000 VNĐ</small>
                </div>
                <button type="submit" class="btn btn-danger w-100">Yêu cầu Rút tiền</button>
            </form>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card p-4 shadow-sm h-100">
            <h4 class="card-title">Lịch sử giao dịch</h4>
            <p class="text-muted">Chức năng này sẽ hiển thị danh sách các giao dịch (Nạp, Rút, Thanh toán).</p>
            <a href="/user/transactions" class="btn btn-outline-secondary mt-auto">Xem lịch sử</a>
        </div>
    </div>
</div>