
  <div class="mx-auto px-4">
    <!-- Flash Messages -->
    <% if (locals.success_msg && success_msg.length > 0) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i><%= success_msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (locals.error_msg && error_msg.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i><%= error_msg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- Page Header -->
    <div class="mb-4">
      <h2 class="fw-bold mb-2">
        <i class="fas fa-wallet me-2 text-primary"></i>Ví của tôi
      </h2>
      <p class="text-muted">Quản lý số dư và giao dịch của bạn</p>
    </div>

    <div class="row">
      <!-- Balance Card -->
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="card shadow-sm bg-gradient-primary text-white border-0">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="mb-0 text-white-50">
                <i class="fas fa-coins me-2"></i>Số dư hiện tại
              </h5>
              <i class="fas fa-wallet fa-2x opacity-50"></i>
            </div>
            <h2 class="fw-bold mb-0">
              <%= typeof wallet !== 'undefined' && wallet.SoDuHienTai ? wallet.SoDuHienTai.toLocaleString('vi-VN') : '0' %>đ
            </h2>
            <p class="text-white-50 mb-0 mt-2">
              <i class="fas fa-info-circle me-1"></i>Có thể sử dụng ngay
            </p>
          </div>
        </div>
      </div>

      <!-- Total Deposit Card -->
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="card shadow-sm border-0">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="mb-0 text-muted">
                <i class="fas fa-plus-circle me-2 text-success"></i>Tổng nạp
              </h5>
              <i class="fas fa-arrow-down fa-2x text-success opacity-25"></i>
            </div>
            <h3 class="fw-bold mb-0 text-success">
              <%= typeof stats !== 'undefined' && stats.totalDeposit ? stats.totalDeposit.toLocaleString('vi-VN') : '0' %>đ
            </h3>
            <p class="text-muted mb-0 mt-2">
              <i class="fas fa-info-circle me-1"></i>Tổng tiền đã nạp
            </p>
          </div>
        </div>
      </div>

      <!-- Total Withdraw Card -->
      <div class="col-lg-4 col-md-6 mb-4">
        <div class="card shadow-sm border-0">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="mb-0 text-muted">
                <i class="fas fa-minus-circle me-2 text-danger"></i>Tổng rút
              </h5>
              <i class="fas fa-arrow-up fa-2x text-danger opacity-25"></i>
            </div>
            <h3 class="fw-bold mb-0 text-danger">
              <%= typeof stats !== 'undefined' && stats.totalWithdraw ? stats.totalWithdraw.toLocaleString('vi-VN') : '0' %>đ
            </h3>
            <p class="text-muted mb-0 mt-2">
              <i class="fas fa-info-circle me-1"></i>Tổng tiền đã rút
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="row mb-4">
      <div class="col-12">
        <div class="card shadow-sm border-0">
          <div class="card-body">
            <h5 class="fw-bold mb-3">
              <i class="fas fa-exchange-alt me-2 text-primary"></i>Thao tác
            </h5>
            <div class="d-flex flex-wrap gap-3">
              <button type="button" class="btn btn-success btn-lg shadow-sm" data-bs-toggle="modal" data-bs-target="#depositModal">
                <i class="fas fa-plus-circle me-2"></i>Nạp tiền
              </button>
              <button type="button" class="btn btn-danger btn-lg shadow-sm" data-bs-toggle="modal" data-bs-target="#withdrawModal">
                <i class="fas fa-minus-circle me-2"></i>Rút tiền
              </button>
              <a href="/user/transactions" class="btn btn-outline-primary btn-lg shadow-sm">
                <i class="fas fa-history me-2"></i>Xem lịch sử đầy đủ
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent Transactions -->
    <div class="row">
      <div class="col-12">
        <div class="card shadow-sm border-0">
          <div class="card-header bg-white border-bottom">
            <h5 class="mb-0 fw-bold">
              <i class="fas fa-list me-2 text-primary"></i>Giao dịch gần đây
            </h5>
          </div>
          <div class="card-body p-0">
            <% if (typeof transactions !== 'undefined' && transactions.length > 0) { %>
              <div class="table-responsive">
                <table class="table table-hover mb-0">
                  <thead class="table-light">
                    <tr>
                      <th class="ps-4">Ngày</th>
                      <th>Loại</th>
                      <th>Số tiền</th>
                      <th>Mô tả</th>
                      <th class="text-center">Trạng thái</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% transactions.forEach(tx => { %>
                      <tr>
                        <td class="ps-4">
                          <%= new Date(tx.NgayGiaoDich).toLocaleString('vi-VN') %>
                        </td>
                        <td>
                          <% if (tx.Loai === 'deposit') { %>
                            <span class="badge bg-success bg-opacity-10 text-success">
                              <i class="fas fa-arrow-down me-1"></i>Nạp tiền
                            </span>
                          <% } else if (tx.Loai === 'withdraw') { %>
                            <span class="badge bg-danger bg-opacity-10 text-danger">
                              <i class="fas fa-arrow-up me-1"></i>Rút tiền
                            </span>
                          <% } else if (tx.Loai === 'commission_payment') { %>
                            <span class="badge bg-info bg-opacity-10 text-info">
                              <i class="fas fa-hand-holding-usd me-1"></i>Nhận hoa hồng
                            </span>
                          <% } else { %>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary">
                              <i class="fas fa-exchange-alt me-1"></i>Khác
                            </span>
                          <% } %>
                        </td>
                        <td class="fw-bold">
                          <% if (tx.Loai === 'deposit' || tx.Loai === 'commission_payment') { %>
                            <span class="text-success">+<%= tx.SoTien.toLocaleString('vi-VN') %>đ</span>
                          <% } else { %>
                            <span class="text-danger">-<%= tx.SoTien.toLocaleString('vi-VN') %>đ</span>
                          <% } %>
                        </td>
                        <td class="text-muted"><%= tx.MoTa || 'Không có mô tả' %></td>
                        <td class="text-center">
                          <% if (tx.TrangThai === 'success') { %>
                            <span class="badge bg-success">
                              <i class="fas fa-check-circle me-1"></i>Thành công
                            </span>
                          <% } else if (tx.TrangThai === 'pending') { %>
                            <span class="badge bg-warning text-dark">
                              <i class="fas fa-clock me-1"></i>Chờ duyệt
                            </span>
                          <% } else if (tx.TrangThai === 'failed') { %>
                            <span class="badge bg-danger">
                              <i class="fas fa-times-circle me-1"></i>Thất bại
                            </span>
                          <% } else { %>
                            <span class="badge bg-secondary">
                              <%= tx.TrangThai %>
                            </span>
                          <% } %>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            <% } else { %>
              <div class="text-center py-5">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">Chưa có giao dịch nào</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Deposit Modal -->
  <div class="modal" id="depositModal" tabindex="-1" aria-labelledby="depositModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="depositModalLabel">
            <i class="fas fa-plus-circle me-2 text-success"></i>Nạp tiền vào ví
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="depositForm">
            <div class="mb-3">
              <label for="depositAmount" class="form-label fw-semibold">
                <i class="fas fa-dollar-sign me-1"></i>Số tiền nạp
              </label>
              <div class="input-group">
                <input type="number" class="form-control form-control-lg" id="depositAmount" name="amount" 
                       min="10000" max="50000000" required
                       placeholder="Nhập số tiền">
                <span class="input-group-text">VNĐ</span>
              </div>
              <small class="text-muted">
                <i class="fas fa-info-circle me-1"></i>Số tiền tối thiểu: 10,000đ - Tối đa: 50,000,000đ
              </small>
            </div>
            <div class="mb-3">
              <label for="depositMethod" class="form-label fw-semibold">
                <i class="fas fa-credit-card me-1"></i>Phương thức thanh toán
              </label>
              <select class="form-select form-select-lg" id="depositMethod" name="method" required>
                <option value="">Chọn phương thức</option>
                <option value="banking">Ngân hàng</option>
                <option value="momo">MoMo</option>
                <option value="zalopay">ZaloPay</option>
              </select>
            </div>
            <div class="alert alert-info mb-0">
              <i class="fas fa-lightbulb me-2"></i>
              <small>Giao dịch sẽ được xử lý tự động sau khi bạn xác nhận</small>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
          <button type="button" class="btn btn-success" id="confirmDeposit">
            <i class="fas fa-check me-2"></i>Xác nhận nạp tiền
          </button>
        </div>
      </div>
    </div>
  </div>

<!-- Modal rút tiền -->
<div class="modal" id="withdrawModal" tabindex="-1" aria-labelledby="withdrawModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="withdrawForm">
        <div class="modal-header">
          <h5 class="modal-title" id="withdrawModalLabel">Rút tiền từ ví</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="withdrawAmount" class="form-label">Số tiền rút</label>
            <input type="number" class="form-control" id="withdrawAmount" name="amount" min="50000" max="50000000" required placeholder="Nhập số tiền rút">
            <small class="form-text text-muted">Tối thiểu 50.000đ, tối đa 50.000.000đ</small>
          </div>
          <div class="mb-3">
            <label for="bankName" class="form-label">Tên ngân hàng</label>
            <input type="text" class="form-control" id="bankName" name="bankName" required>
          </div>
          <div class="mb-3">
            <label for="accountNumber" class="form-label">Số tài khoản</label>
            <input type="text" class="form-control" id="accountNumber" name="accountNumber" required>
          </div>
          <div class="mb-3">
            <label for="accountHolder" class="form-label">Chủ tài khoản</label>
            <input type="text" class="form-control" id="accountHolder" name="accountHolder" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
          <button type="button" class="btn btn-danger" id="confirmWithdraw">Xác nhận rút tiền</button>
        </div>
      </form>
    </div>
  </div>
</div>

  <!-- Loading Toast -->
  <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="loadingToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="1000">
      <div class="toast-header bg-primary text-white">
        <i class="fas fa-spinner fa-spin me-2"></i>
        <strong class="me-auto">Đang xử lý...</strong>
      </div>
    </div>
  </div>

  <!-- Success Toast -->
  <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="successToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000">
      <div class="toast-header bg-success text-white">
        <i class="fas fa-check-circle me-2"></i>
        <strong class="me-auto">Thành công!</strong>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
      </div>
      <div class="toast-body" id="successToastBody"></div>
    </div>
  </div>

  <!-- Error Toast -->
  <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="errorToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000">
      <div class="toast-header bg-danger text-white">
        <i class="fas fa-exclamation-circle me-2"></i>
        <strong class="me-auto">Lỗi!</strong>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
      </div>
      <div class="toast-body" id="errorToastBody"></div>
    </div>
  </div>

  <!-- Custom CSS -->
  <style>
    .bg-gradient-primary {
      background: linear-gradient(135deg, #0061f2 0%, #0044b3 100%);
    }
    .opacity-50 {
      opacity: 0.5;
    }
    .opacity-25 {
      opacity: 0.25;
    }
    .fw-semibold {
      font-weight: 600;
    }
    .table td, .table th {
      vertical-align: middle;
      border-top: 1px solid #e9ecef;
    }
    .toast {
      border: none;
      box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
  </style>

  <!-- JavaScript -->
  <script>
    // Get current balance for reference
    const currentBalance =  typeof wallet !== 'undefined' && wallet.SoDuHienTai ? wallet.SoDuHienTai : 0 ;
    
    // Update max withdraw info
    document.addEventListener('DOMContentLoaded', function() {
      const maxWithdrawInfo = document.getElementById('maxWithdrawInfo');
      if (maxWithdrawInfo) {
        maxWithdrawInfo.innerHTML = '<i class="fas fa-wallet me-1"></i>Số dư hiện tại: ' + currentBalance.toLocaleString('vi-VN') + 'đ';
      }

      // Deposit Form Handler
      document.getElementById('confirmDeposit').addEventListener('click', async function() {
        const form = document.getElementById('depositForm');
        const formData = new FormData(form);
        
        const amount = parseInt(formData.get('amount'));
        const method = formData.get('method');

        // Validation
        if (!amount || amount < 10000 || amount > 50000000) {
          showToast('error', 'Số tiền phải từ 10,000đ đến 50,000,000đ');
          return;
        }

        if (!method) {
          showToast('error', 'Vui lòng chọn phương thức thanh toán');
          return;
        }

        // Show loading
        const loadingToast = new bootstrap.Toast(document.getElementById('loadingToast'));
        loadingToast.show();

        try {
          const response = await fetch('/api/wallet/deposit', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ amount, method })
          });

          const data = await response.json();

          if (data.success) {
            showToast('success', data.message);
            setTimeout(() => {
              window.location.reload();
            }, 2000);
          } else {
            showToast('error', data.message || 'Có lỗi xảy ra khi nạp tiền');
          }
        } catch (error) {
          console.error('Error:', error);
          showToast('error', 'Có lỗi xảy ra khi nạp tiền');
        } finally {
          loadingToast.hide();
        }
      });

      // Withdraw Form Handler
      document.getElementById('confirmWithdraw').addEventListener('click', async function() {
        const form = document.getElementById('withdrawForm');
        const formData = new FormData(form);
        
        const amount = parseInt(formData.get('amount'));
        const bankName = formData.get('bankInfo.bankName');
        const accountNumber = formData.get('bankInfo.accountNumber');
        const accountHolder = formData.get('bankInfo.accountHolder');

        // Validation
        if (!amount || amount < 50000 || amount > 50000000) {
          showToast('error', 'Số tiền phải từ 50,000đ đến 50,000,000đ');
          return;
        }

        if (amount > currentBalance) {
          showToast('error', 'Số dư không đủ để thực hiện giao dịch này');
          return;
        }

        if (!bankName || !accountNumber || !accountHolder) {
          showToast('error', 'Vui lòng nhập đầy đủ thông tin ngân hàng');
          return;
        }

        // Validate account number
        if (!/^\d{8,15}$/.test(accountNumber)) {
          showToast('error', 'Số tài khoản không hợp lệ (8-15 chữ số)');
          return;
        }

        // Show loading
        const loadingToast = new bootstrap.Toast(document.getElementById('loadingToast'));
        loadingToast.show();

        try {
          const response = await fetch('/api/wallet/withdraw', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ 
              amount, 
              bankInfo: {
                bankName,
                accountNumber,
                accountHolder
              }
            })
          });

          const data = await response.json();

          if (data.success) {
            showToast('success', data.message);
            setTimeout(() => {
              window.location.reload();
            }, 2000);
          } else {
            showToast('error', data.message || 'Có lỗi xảy ra khi rút tiền');
          }
        } catch (error) {
          console.error('Error:', error);
          showToast('error', 'Có lỗi xảy ra khi rút tiền');
        } finally {
          loadingToast.hide();
        }
      });

      // Toast helper function
      function showToast(type, message) {
        let toastElement, toastBody;
        
        if (type === 'success') {
          toastElement = document.getElementById('successToast');
          toastBody = document.getElementById('successToastBody');
        } else if (type === 'error') {
          toastElement = document.getElementById('errorToast');
          toastBody = document.getElementById('errorToastBody');
        }
        
        if (toastBody) {
          toastBody.textContent = message;
        }
        
        if (toastElement) {
          const toast = new bootstrap.Toast(toastElement);
          toast.show();
        }
      }

      // Reset forms when modal is hidden
      document.getElementById('depositModal').addEventListener('hidden.bs.modal', function() {
        document.getElementById('depositForm').reset();
      });

      document.getElementById('withdrawModal').addEventListener('hidden.bs.modal', function() {
        document.getElementById('withdrawForm').reset();
      });
    });
  </script>
