<%- include('../layout', { body: renderBody() }) %>
<% function renderBody() { %>
<div class="container">
  <div class="row justify-content-center" style="margin-top: 80px;">
    <div class="col-md-6 col-lg-5">
      <div class="card border-0 shadow">
        <div class="card-body p-5">
          <h2 class="text-center h4 mb-4">Đăng ký tài khoản</h2>
          
          <% if (success_msg && success_msg.length) { %>
            <div class="alert alert-success mb-4" role="alert">
              <%= success_msg %>
            </div>
          <% } %>

          <% if (error_msg && error_msg.length) { %>
            <div class="alert alert-danger mb-4" role="alert">
              <%= error_msg %>
            </div>
          <% } %>

          <form action="/auth/register" method="POST">
            <div class="mb-3">
              <label for="name" class="form-label">Họ và tên</label>
              <div class="input-group">
                <span class="input-group-text bg-light">
                  <i class="fas fa-user text-primary"></i>
                </span>
                <input type="text" 
                       name="name" 
                       id="name" 
                       class="form-control bg-light" 
                       placeholder="Nhập họ và tên của bạn"
                       required />
              </div>
            </div>

            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <div class="input-group">
                <span class="input-group-text bg-light">
                  <i class="fas fa-envelope text-primary"></i>
                </span>
                <input type="email" 
                       name="email" 
                       id="email" 
                       class="form-control bg-light" 
                       placeholder="example@domain.com"
                       required />
              </div>
            </div>

            <div class="mb-3">
              <label for="password" class="form-label">Mật khẩu</label>
              <div class="input-group">
                <span class="input-group-text bg-light">
                  <i class="fas fa-lock text-primary"></i>
                </span>
                <input type="password" 
                       name="password" 
                       id="password" 
                       class="form-control bg-light" 
                       placeholder="Tối thiểu 6 ký tự"
                       required />
              </div>
            </div>

            <div class="mb-4">
              <label for="password2" class="form-label">Xác nhận mật khẩu</label>
              <div class="input-group">
                <span class="input-group-text bg-light">
                  <i class="fas fa-lock text-primary"></i>
                </span>
                <input type="password" 
                       name="password2" 
                       id="password2" 
                       class="form-control bg-light" 
                       placeholder="Nhập lại mật khẩu"
                       required />
              </div>
            </div>

            <div class="d-grid gap-2 mb-3">
              <button type="submit" class="btn btn-primary py-2">
                <i class="fas fa-user-plus me-2"></i>Đăng ký
              </button>
            </div>

            <div class="text-center">
              <p class="mb-0">Đã có tài khoản? 
                <a href="/auth/login" class="text-decoration-none">Đăng nhập ngay</a>
              </p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>